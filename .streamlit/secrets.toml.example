# Copy this file to .streamlit/secrets.toml, then UNCOMMENT the two blocks
# below and replace every placeholder with your own value:
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# (Everything here is commented out on purpose: a copy left as-is starts
# sign-in against a nonexistent OIDC client, which fails at the provider
# rather than in a way the app can explain.)
#
# PLACEHOLDERS ONLY in this file — it is committed. The real secrets.toml holds
# a live OAuth client secret and a cookie signing key: never commit it, and
# check that your .gitignore excludes it before your first commit.
#
# The app requires this file. Without it nobody can sign in, and without a
# [roles] entry nobody is served — including you (REQUIREMENTS § 21, ADR-0200).


# ---------------------------------------------------------------------------
# [auth] — authentication (who is this?)
# ---------------------------------------------------------------------------
# Consumed by Streamlit's native OIDC support (st.login / st.user / st.logout),
# not by this app's code: no credential is ever handled here. Requires the
# `Authlib` dependency (>=1.3.2), which `uv sync` installs.
#
# Register an OIDC client with your provider first. For Google that is a
# "Web application" OAuth 2.0 Client ID in Google Cloud Console
# (APIs & Services -> Credentials), whose "Authorized redirect URIs" must list
# the exact redirect_uri below.

# [auth]
# # Must match a redirect URI registered with the provider, EXACTLY — scheme,
# # host, port and path. It differs per environment, and a drifted value fails
# # at sign-in with a provider error rather than anything the app can explain:
# #   local     http://localhost:8501/oauth2callback
# #   deployed  https://<your-app-host>/oauth2callback
# redirect_uri = "http://localhost:8501/oauth2callback"
#
# # A random secret used to sign the identity cookie. Generate your own, e.g.
# #   python -c "import secrets; print(secrets.token_hex(32))"
# cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"
#
# client_id = "REPLACE_WITH_YOUR_OIDC_CLIENT_ID"
# client_secret = "REPLACE_WITH_YOUR_OIDC_CLIENT_SECRET"
#
# # The provider's OpenID discovery document. For Google:
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"


# ---------------------------------------------------------------------------
# [roles] — authorization (may they be here?)
# ---------------------------------------------------------------------------
# A signed-in email is served only if it appears here: presence is
# authorization, ABSENCE IS REFUSAL. Signing in with Google proves an address
# and nothing more — every Google account holder on earth can do it — while
# every turn spends the operator's own OpenRouter credit, so identity alone is
# not grounds to serve anyone.
#
# The value is the role: "dev" (adds the Developer and Warnings sidebar tabs)
# or "user". An unrecognized role name costs privilege but keeps access; an
# absent, unreadable or non-mapping table authorizes NOBODY, operator included.
# That is deliberate: a deployment serving no one is fixed in minutes, while
# one silently admitting the world to a funded API key produces only a bill.
#
# Addresses are compared case-insensitively and whitespace-stripped, so casing
# here does not matter. Also list your own address — you are not exempt.

# [roles]
# "operator@example.com" = "dev"
# "candidate@example.com" = "user"


# ---------------------------------------------------------------------------
# [spend] — the per-identity spend cap (how much may they spend?)
# ---------------------------------------------------------------------------
# The third question, after "who is this?" and "may they be here?". Every turn
# draws on the operator's own OpenRouter credit, and an allowlisted user with a
# free afternoon can spend an unbounded amount of it (REQUIREMENTS § 22,
# ADR-0210).
#
# The ledger is an external Postgres because the total must survive a container
# restart: Streamlit Community Cloud recycles containers freely, and a cap that
# silently resets to zero is not a cap. Create the table once:
#
#   create table spend (
#     email      text primary key,
#     total_usd  numeric(12, 6) not null default 0,
#     updated_at timestamptz     not null default now()
#   );
#
# WITHOUT THIS BLOCK THE APP SERVES NOBODY. An unreachable or unconfigured
# ledger fails closed (R22.12) — the same deliberate choice as an unusable
# [roles] table. A deployment that refuses everyone is fixed in minutes; one
# that silently uncaps every account produces only a bill.

# [spend]
# # Use the TRANSACTION POOLER string (port 6543, host contains "pooler"), not
# # the direct connection (port 5432): Streamlit containers are short-lived and
# # numerous, and direct connections exhaust the limit. In the Supabase
# # dashboard: Connect -> ORMs -> the URL with :6543. Strip any trailing
# # "?pgbouncer=true" — that is a Prisma flag and libpq rejects it.
# #
# # PERCENT-ENCODE THE PASSWORD. Supabase generates passwords containing URI
# # reserved characters (@ : / ? # are all possible), and a raw "@" splits the
# # URI at the wrong place: libpq then reports "failed to resolve host" naming
# # a host built from the tail of your password, which reads like a DNS fault
# # rather than a quoting one. Encode @ as %40, : as %3A, / as %2F, # as %23,
# # % as %25. Simplest alternative: reset the database password to something
# # alphanumeric.
# #
# # This string embeds a live database password. It belongs here and nowhere
# # else: not in .env.example, not in a commit, not in a test fixture.
# connection_string = "postgresql://postgres.PROJECT_REF:REPLACE_WITH_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
#
# # Lifetime USD per authorized identity — no period, no reset (R22.1).
# # The `dev` role is not capped (R22.9).
# cap_usd = 5.00
