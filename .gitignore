# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv

# Local secrets
.env

# Derived data — the knowledge-base DB is rebuilt from knowledgebase/ seeds
data/

# Editor / IDE (no trailing slash: these appear as /dev/null device nodes
# under WSL, not real directories, so a dir-only pattern would miss them)
.idea
.vscode

# Tooling / agent local state
.claude/
.mcp.json
.ripgreprc
.gitmodules

# Shell / user dotfiles that ended up in the tree
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig

# Local-only developer files (fixtures, scratch, notes) — never committed
dev_local/
