# Copy this file to .env and fill in your key. .env is gitignored.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: enables the interviewer's GitHub portfolio tools (MCP).
# Create a fine-grained PAT with read-only access to public repositories at
# https://github.com/settings/personal-access-tokens
GITHUB_PAT=

# Optional: the session's role, for the developer view (REQUIREMENTS § 20).
# "dev" shows the Developer and Warnings sidebar tabs; anything else — including
# absent, misspelled, or unset — is treated as "user" and shows neither.
# This is configuration, not authentication: it is only settable server-side
# (environment or Streamlit secrets), never from the browser.
INTERVIEW_PREP_ROLE=
